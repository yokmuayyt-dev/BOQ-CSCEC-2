<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบจัดทำ BOQ โครงการอาคาร 30 ชั้น (1,000 ล้านบาท)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Prompt -->
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- SheetJS for Excel Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <!-- html2pdf for PDF Export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <!-- Chart.js for Dashboard -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Prompt', 'sans-serif'],
                    },
                    colors: {
                        navy: {
                            800: '#1e293b',
                            900: '#0f172a',
                        },
                        amber: {
                            500: '#f59e0b',
                            600: '#d97706',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Prompt', sans-serif; background-color: #f8fafc; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background: white; color: black; }
        }
    </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- Top Navigation Header -->
    <header class="bg-slate-900 text-white shadow-lg sticky top-0 z-40 no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Logo & Title -->
                <div class="flex items-center space-x-3">
                    <div class="p-2 bg-amber-500 rounded-lg text-slate-900 font-bold">
                        <i class="fa-solid fa-building fa-lg"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-lg leading-tight" data-i18n="appTitle">ระบบบริหารและจัดทำ BOQ อาคารสูง</h1>
                        <p class="text-xs text-slate-400" data-i18n="appSubtitle">โครงการอาคาร 30 ชั้น (งบประมาณ 1,000,000,000 บาท)</p>
                    </div>
                </div>

                <!-- Project Selector, Language Toggle & Actions -->
                <div class="flex items-center space-x-2 sm:space-x-3">
                    <!-- Language Switcher -->
                    <div class="bg-slate-800 border border-slate-700 rounded-lg p-0.5 flex items-center">
                        <button id="lang-th-btn" onclick="setLanguage('th')" class="px-2.5 py-1 text-xs font-bold rounded-md transition bg-amber-500 text-slate-950">TH</button>
                        <button id="lang-en-btn" onclick="setLanguage('en')" class="px-2.5 py-1 text-xs font-bold rounded-md transition text-slate-400 hover:text-white">EN</button>
                    </div>

                    <!-- Select Active Project -->
                    <div class="relative">
                        <select id="projectSelect" onchange="changeProject(this.value)" class="bg-slate-800 text-amber-400 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs sm:text-sm font-medium focus:outline-none focus:ring-2 focus:ring-amber-500 max-w-[140px] sm:max-w-xs truncate">
                            <!-- Populated by JS -->
                        </select>
                    </div>

                    <button onclick="createNewProjectPrompt()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 px-2.5 py-1.5 rounded-lg text-xs sm:text-sm flex items-center gap-1 transition">
                        <i class="fa-solid fa-plus text-amber-400"></i>
                        <span class="hidden md:inline" data-i18n="addProject">เพิ่มโครงการ</span>
                    </button>

                    <!-- Export Options -->
                    <button onclick="exportToExcel()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-2.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium flex items-center gap-1 transition shadow">
                        <i class="fa-solid fa-file-excel"></i>
                        <span>Excel</span>
                    </button>
                    <button onclick="exportToPDF()" class="bg-rose-600 hover:bg-rose-500 text-white px-2.5 py-1.5 rounded-lg text-xs sm:text-sm font-medium flex items-center gap-1 transition shadow">
                        <i class="fa-solid fa-file-pdf"></i>
                        <span>PDF</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation Tabs -->
    <div class="bg-white border-b border-slate-200 no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="flex space-x-6 sm:space-x-8 overflow-x-auto">
                <button id="tab-summary-btn" onclick="switchTab('summary')" class="py-3 px-1 border-b-2 border-amber-500 font-medium text-sm text-amber-600 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-chart-pie"></i> <span data-i18n="tabSummary">สรุปภาพรวมโครงการ (Executive Summary)</span>
                </button>
                <button id="tab-boq-btn" onclick="switchTab('boq')" class="py-3 px-1 border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-slate-700 hover:border-slate-300 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-list-check"></i> <span data-i18n="tabBOQ">รายการ BOQ แบบละเอียด</span>
                </button>
                <button id="tab-settings-btn" onclick="switchTab('settings')" class="py-3 px-1 border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-slate-700 hover:border-slate-300 flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-sliders"></i> <span data-i18n="tabSettings">ตั้งค่า Factor F & VAT / สำรองข้อมูล</span>
                </button>
            </nav>
        </div>
    </div>

    <!-- MAIN CONTENT AREA -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-grow w-full">

        <!-- SUMMARY TAB -->
        <div id="tab-summary" class="space-y-6">
            <!-- Project Header Card -->
            <div class="bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950 rounded-2xl p-6 text-white shadow-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                <div>
                    <span class="inline-block bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs px-2.5 py-1 rounded-full font-semibold mb-2" id="sumProjCode">PRJ-30FL-1000M</span>
                    <h2 class="text-2xl font-bold text-white" id="sumProjName">โครงการอาคารมิกซ์ยูส 30 ชั้น (The Grand Tower)</h2>
                    <p class="text-slate-300 text-sm mt-1" id="sumProjDesc">พื้นที่ก่อสร้างรวม 45,000 ตร.ม. | ความสูง 30 ชั้น + ชั้นใต้ดิน 2 ชั้น</p>
                </div>
                <div class="bg-white/10 backdrop-blur border border-white/10 rounded-xl p-4 text-right min-w-[240px]">
                    <div class="text-xs text-slate-300" data-i18n="lblTargetBudget">งบประมาณเป้าหมาย (Target Budget)</div>
                    <div class="text-2xl font-bold text-amber-400" id="sumTargetBudget">1,000,000,000 ฿</div>
                    <div class="text-xs text-slate-400 mt-1" id="sumBudgetDiff">ส่วนต่าง: 0 ฿</div>
                </div>
            </div>

            <!-- Summary Key Metrics Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <div class="text-xs font-semibold uppercase text-slate-400" data-i18n="cardDirectCost">รวมค่างานต้นทุน (Direct Cost)</div>
                        <div class="text-xl font-bold text-slate-800 mt-1" id="cardDirectCostVal">0 ฿</div>
                        <div class="text-xs text-slate-500 mt-1" data-i18n="subDirectCost">ค่างานรวมวัสดุ + ค่าแรง</div>
                    </div>
                    <div class="p-3 bg-blue-50 text-blue-600 rounded-lg"><i class="fa-solid fa-calculator fa-xl"></i></div>
                </div>

                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <div class="text-xs font-semibold uppercase text-slate-400" data-i18n="cardFactorF">ค่าดำเนินการ / Factor F</div>
                        <div class="text-xl font-bold text-slate-800 mt-1" id="cardFactorFCost">0 ฿</div>
                        <div class="text-xs text-amber-600 font-medium mt-1" id="cardFactorFPercent">Factor F: 15%</div>
                    </div>
                    <div class="p-3 bg-amber-50 text-amber-600 rounded-lg"><i class="fa-solid fa-percent fa-xl"></i></div>
                </div>

                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <div class="text-xs font-semibold uppercase text-slate-400" data-i18n="cardVat">ภาษีมูลค่าเพิ่ม (VAT)</div>
                        <div class="text-xl font-bold text-slate-800 mt-1" id="cardVatCost">0 ฿</div>
                        <div class="text-xs text-slate-500 mt-1" data-i18n="subVat">คำนวณจากค่างานสุทธิ</div>
                    </div>
                    <div class="p-3 bg-purple-50 text-purple-600 rounded-lg"><i class="fa-solid fa-receipt fa-xl"></i></div>
                </div>

                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between border-l-4 border-l-emerald-500">
                    <div>
                        <div class="text-xs font-semibold uppercase text-emerald-600" data-i18n="cardGrandTotal">ราคาก่อสร้างรวมทั้งสิ้น</div>
                        <div class="text-2xl font-bold text-emerald-700 mt-1" id="cardGrandTotal">0 ฿</div>
                        <div class="text-xs text-slate-500 mt-1" id="cardCostPerSqm">เฉลี่ย 0 บาท / ตร.ม.</div>
                    </div>
                    <div class="p-3 bg-emerald-50 text-emerald-600 rounded-lg"><i class="fa-solid fa-sack-dollar fa-xl"></i></div>
                </div>
            </div>

            <!-- Charts & Category Breakdown Table -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Doughnut Chart -->
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
                    <h3 class="font-bold text-slate-800 mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-chart-pie text-amber-500"></i> <span data-i18n="chartTitle">สัดส่วนงบประมาณตามหมวดงานหลัก</span>
                    </h3>
                    <div class="relative h-64 flex items-center justify-center">
                        <canvas id="boqChart"></canvas>
                    </div>
                    <div class="text-xs text-center text-slate-400 mt-4" data-i18n="chartSub">
                        * แสดงสัดส่วนต้นทุนจากหมวดงานหลัก
                    </div>
                </div>

                <!-- Major Category Table -->
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm lg:col-span-2 flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="font-bold text-slate-800 flex items-center gap-2">
                                <i class="fa-solid fa-table-list text-amber-500"></i> <span data-i18n="summaryTableTitle">สรุปราคาก่อสร้างแยกตามหมวดงานหลัก</span>
                            </h3>
                            <button onclick="switchTab('boq')" class="text-xs font-medium text-amber-600 hover:text-amber-700 flex items-center gap-1">
                                <span data-i18n="manageItems">จัดการรายการ</span> <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-100 text-slate-700 border-b border-slate-200">
                                        <th class="p-3 rounded-tl-lg" data-i18n="thCategory">หมวดงาน (Category)</th>
                                        <th class="p-3 text-right" data-i18n="thMat">ค่าวัสดุ</th>
                                        <th class="p-3 text-right" data-i18n="thLabor">ค่าแรง</th>
                                        <th class="p-3 text-right" data-i18n="thTotal">รวมเป็นเงิน</th>
                                        <th class="p-3 text-right rounded-tr-lg" data-i18n="thRatio">สัดส่วน (%)</th>
                                    </tr>
                                </thead>
                                <tbody id="summaryTableBody" class="divide-y divide-slate-100">
                                    <!-- Dynamic rows -->
                                </tbody>
                                <tfoot>
                                    <tr class="bg-slate-50 font-bold text-slate-800 border-t border-slate-200">
                                        <td class="p-3" data-i18n="tfTotalDirect">รวมค่างานต้นทุนทางตรง (Direct Cost)</td>
                                        <td class="p-3 text-right text-blue-700" id="sumTableMat">0</td>
                                        <td class="p-3 text-right text-indigo-700" id="sumTableLabor">0</td>
                                        <td class="p-3 text-right text-emerald-700" id="sumTableDirect">0</td>
                                        <td class="p-3 text-right">100%</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-slate-100 flex justify-between items-center text-xs text-slate-500">
                        <span id="footerBuildingInfo">อาคาร 30 ชั้น | พื้นที่ใช้สอยโดยประมาณ 45,000 ตร.ม.</span>
                        <span class="font-semibold text-slate-700"><span data-i18n="lastUpdated">อัปเดตล่าสุด:</span> <span id="lastUpdatedDate">-</span></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOQ DETAILED EDITOR TAB -->
        <div id="tab-boq" class="hidden space-y-6">
            <!-- Toolbar & Controls -->
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-sm font-semibold text-slate-700" data-i18n="controlPanel">แผงควบคุม BOQ:</span>
                    <button onclick="expandAllCategories()" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1.5 rounded border border-slate-300">
                        <i class="fa-solid fa-angles-down mr-1"></i> <span data-i18n="expandAll">ขยายทั้งหมด</span>
                    </button>
                    <button onclick="collapseAllCategories()" class="text-xs bg-slate-100 hover:bg-slate-200 text-slate-700 px-2.5 py-1.5 rounded border border-slate-300">
                        <i class="fa-solid fa-angles-up mr-1"></i> <span data-i18n="collapseAll">ย่อทั้งหมด</span>
                    </button>
                    <button id="btnAutoTranslate" onclick="autoTranslateProject()" class="text-xs bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1.5 rounded-lg font-semibold flex items-center gap-1.5 transition shadow-sm">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> <span data-i18n="btnAutoTranslate">Auto-Translate (แปลภาษาด้วย AI/Dict)</span>
                    </button>
                </div>

                <div class="flex items-center gap-3 w-full sm:w-auto">
                    <!-- Quick Add Main Category -->
                    <button onclick="addMainCategoryPrompt()" class="bg-amber-500 hover:bg-amber-600 text-slate-900 font-medium px-3 py-1.5 rounded-lg text-sm flex items-center gap-1.5 transition shadow-sm w-full sm:w-auto justify-center">
                        <i class="fa-solid fa-folder-plus"></i> <span data-i18n="btnAddMainCategory">เพิ่มหมวดงานหลัก</span>
                    </button>
                </div>
            </div>

            <!-- BOQ Main Container (Rendered dynamically) -->
            <div id="boqContainer" class="space-y-6">
                <!-- Main categories render here -->
            </div>
        </div>

        <!-- SETTINGS TAB -->
        <div id="tab-settings" class="hidden space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">
                <!-- Settings Form -->
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
                    <h3 class="text-lg font-bold text-slate-800 border-b border-slate-200 pb-3 flex items-center gap-2">
                        <i class="fa-solid fa-sliders text-amber-500"></i> <span data-i18n="settingsTitle">ตั้งค่าข้อมูลโครงการและปัจจัยทางการเงิน</span>
                    </h3>

                    <form onsubmit="saveSettings(event)" class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1" data-i18n="lblProjNameTh">ชื่อโครงการ (ไทย)</label>
                            <input type="text" id="settingProjName" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none" required>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1" data-i18n="lblProjNameEn">ชื่อโครงการ (English)</label>
                            <input type="text" id="settingProjNameEn" placeholder="The Grand Tower 30-Story Mixed-Use" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1" data-i18n="lblProjCode">รหัสโครงการ</label>
                                <input type="text" id="settingProjCode" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1" data-i18n="lblTotalArea">พื้นที่อาคารรวม (ตร.ม.)</label>
                                <input type="number" id="settingArea" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1" data-i18n="lblTargetBudgetInput">งบประมาณเป้าหมาย (บาท)</label>
                            <input type="number" id="settingTargetBudget" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none" required>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-100">
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Factor F (%)</label>
                                <input type="number" step="0.01" id="settingFactorF" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">VAT (%)</label>
                                <input type="number" step="0.01" id="settingVat" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                            </div>
                        </div>

                        <div class="pt-4 flex justify-end">
                            <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-slate-900 font-semibold px-5 py-2 rounded-lg text-sm transition">
                                <i class="fa-solid fa-floppy-disk mr-1"></i> <span data-i18n="btnSaveSettings">บันทึกการตั้งค่า</span>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Backup & Restore Box -->
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4 flex flex-col justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-slate-800 border-b border-slate-200 pb-3 flex items-center gap-2">
                            <i class="fa-solid fa-database text-amber-500"></i> <span data-i18n="backupTitle">จัดการฐานข้อมูลโครงการ (Backup / Restore)</span>
                        </h3>
                        <p class="text-xs text-slate-500 mt-3 leading-relaxed" data-i18n="backupDesc">
                            คุณสามารถส่งออกข้อมูลโครงการทั้งหมดเป็นไฟล์ JSON เพื่อสำรองข้อมูล หรือนำเข้าข้อมูลโครงการเดิมเมื่อต้องการย้ายเครื่องทำงาน
                        </p>

                        <div class="mt-6 space-y-3">
                            <button onclick="downloadBackupJSON()" class="w-full bg-slate-800 hover:bg-slate-700 text-white font-medium py-2.5 px-4 rounded-lg text-sm flex items-center justify-center gap-2 transition">
                                <i class="fa-solid fa-download text-amber-400"></i> <span data-i18n="btnDownloadBackup">สำรองข้อมูลทั้งหมด (Backup JSON)</span>
                            </button>

                            <div class="relative">
                                <input type="file" id="restoreFileInput" onchange="restoreBackupJSON(event)" accept=".json" class="hidden">
                                <button onclick="document.getElementById('restoreFileInput').click()" class="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 font-medium py-2.5 px-4 rounded-lg text-sm flex items-center justify-center gap-2 transition">
                                    <i class="fa-solid fa-upload text-indigo-600"></i> <span data-i18n="btnRestoreBackup">นำเข้าข้อมูลสำรอง (Restore JSON)</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-100">
                        <button onclick="resetToDefaultData()" class="text-xs text-rose-500 hover:text-rose-700 font-medium flex items-center gap-1">
                            <i class="fa-solid fa-arrow-rotate-left"></i> <span data-i18n="btnResetDefault">รีเซ็ตกลับไปใช้ข้อมูลตัวอย่างเริ่มต้น</span>
                        </button>
                    </div>
                </div>
            </div>
