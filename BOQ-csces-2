        // Calculations
        function calculateBOQTotals(proj) {
            let grandDirectMaterial = 0;
            let grandDirectLabor = 0;
            const categoryTotals = [];

            proj.mainCategories.forEach(mc => {
                let mcMat = 0;
                let mcLabor = 0;

                mc.subCategories.forEach(sc => {
                    let scMat = 0;
                    let scLabor = 0;
                    sc.items.forEach(item => {
                        const mat = (parseFloat(item.qty) || 0) * (parseFloat(item.matPrice) || 0);
                        const labor = (parseFloat(item.qty) || 0) * (parseFloat(item.laborPrice) || 0);
                        scMat += mat;
                        scLabor += labor;
                    });
                    sc.totalMat = scMat;
                    sc.totalLabor = scLabor;
                    sc.totalSum = scMat + scLabor;

                    mcMat += scMat;
                    mcLabor += scLabor;
                });

                mc.totalMat = mcMat;
                mc.totalLabor = mcLabor;
                mc.totalSum = mcMat + mcLabor;

                grandDirectMaterial += mcMat;
                grandDirectLabor += mcLabor;

                const displayTitle = (currentLang === 'en' && mc.titleEn) ? mc.titleEn : mc.title;
                categoryTotals.push({
                    title: displayTitle,
                    mat: mcMat,
                    labor: mcLabor,
                    total: mcMat + mcLabor
                });
            });

            const directCost = grandDirectMaterial + grandDirectLabor;
            const factorFCost = directCost * ((proj.factorFPercent || 0) / 100);
            const netBeforeVat = directCost + factorFCost;
            const vatCost = netBeforeVat * ((proj.vatPercent || 0) / 100);
            const grandTotal = netBeforeVat + vatCost;

            return {
                grandDirectMaterial,
                grandDirectLabor,
                directCost,
                factorFCost,
                netBeforeVat,
                vatCost,
                grandTotal,
                categoryTotals
            };
        }

