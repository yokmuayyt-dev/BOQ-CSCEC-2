                            <th style="padding: 6px; text-align: right; width: 80px;">${dict.thLaborUnit}</th>
                            <th style="padding: 6px; text-align: right; width: 85px;">${dict.thLaborTotal}</th>
                            <th style="padding: 6px; text-align: right; width: 95px;">${dict.thGrandTotal}</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            proj.mainCategories.forEach(mc => {
                const mcTitle = (isEn && mc.titleEn) ? mc.titleEn : mc.title;
                html += `
                    <tr style="background-color: #f1f5f9; font-weight: bold; border: 1px solid #cbd5e1;">
                        <td style="padding: 6px; text-align: center;">${mc.code}</td>
                        <td colspan="7" style="padding: 6px;">${mcTitle}</td>
                        <td style="padding: 6px; text-align: right; color: #0f172a;">${formatMoney(mc.totalSum)}</td>
                    </tr>
                `;

                mc.subCategories.forEach(sc => {
                    const scTitle = (isEn && sc.titleEn) ? sc.titleEn : sc.title;
                    html += `
                        <tr style="background-color: #f8fafc; font-weight: 600; border: 1px solid #e2e8f0;">
                            <td></td>
                            <td colspan="7" style="padding: 4px 6px; padding-left: 20px; color: #334155;">${scTitle}</td>
                            <td style="padding: 4px 6px; text-align: right;">${formatMoney(sc.totalSum)}</td>
                        </tr>
                    `;

                    sc.items.forEach(item => {
                        const totalMat = (item.qty || 0) * (item.matPrice || 0);
                        const totalLabor = (item.qty || 0) * (item.laborPrice || 0);
                        const sum = totalMat + totalLabor;

                        const itemDesc = (isEn && item.descEn) ? item.descEn : item.desc;
                        const itemUnit = (isEn && item.unitEn) ? item.unitEn : item.unit;

                        html += `
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 4px; text-align: center; color: #64748b;">${item.code || ''}</td>
                                <td style="padding: 4px; padding-left: 32px; color: #1e293b;">${itemDesc || ''}</td>
                                <td style="padding: 4px; text-align: right;">${formatMoney(item.qty)}</td>
                                <td style="padding: 4px; text-align: center;">${itemUnit || ''}</td>
                                <td style="padding: 4px; text-align: right;">${formatMoney(item.matPrice)}</td>
                                <td style="padding: 4px; text-align: right;">${formatMoney(totalMat)}</td>
                                <td style="padding: 4px; text-align: right;">${formatMoney(item.laborPrice)}</td>
                                <td style="padding: 4px; text-align: right;">${formatMoney(totalLabor)}</td>
                                <td style="padding: 4px; text-align: right; font-weight: 600;">${formatMoney(sum)}</td>
                            </tr>
                        `;
                    });
                });
            });

            html += `
                    <!-- Summary Footer -->
                    <tr style="border-top: 2px solid #0f172a; font-weight: bold; background-color: #f8fafc;">
                        <td colspan="5" style="padding: 8px; text-align: right;">${dict.tfTotalDirect}</td>
                        <td style="padding: 8px; text-align: right;">${formatMoney(totals.grandDirectMaterial)}</td>
                        <td></td>
                        <td style="padding: 8px; text-align: right;">${formatMoney(totals.grandDirectLabor)}</td>
                        <td style="padding: 8px; text-align: right; color: #1e3a8a;">${formatMoney(totals.directCost)}</td>
                    </tr>
                    <tr style="font-weight: bold;">
                        <td colspan="8" style="padding: 6px; text-align: right;">${dict.cardFactorF} (${proj.factorFPercent}%)</td>
                        <td style="padding: 6px; text-align: right;">${formatMoney(totals.factorFCost)}</td>
                    </tr>
                    <tr style="font-weight: bold;">
                        <td colspan="8" style="padding: 6px; text-align: right;">${dict.cardVat} (${proj.vatPercent}%)</td>
                        <td style="padding: 6px; text-align: right;">${formatMoney(totals.vatCost)}</td>
                    </tr>
                    <tr style="font-weight: bold; background-color: #fef3c7; border: 2px solid #f59e0b; font-size: 13px;">
                        <td colspan="8" style="padding: 8px; text-align: right; color: #78350f;">${dict.cardGrandTotal}</td>
                        <td style="padding: 8px; text-align: right; color: #78350f;">${formatMoney(totals.grandTotal)} ${dict.currencyUnit}</td>
                    </tr>
                </tbody>
            </table>
            `;

            document.getElementById('printTableContent').innerHTML = html;

            const printElement = document.getElementById('pdfPrintArea');
            printElement.classList.remove('hidden');

            const opt = {
                margin:       [0.4, 0.4, 0.4, 0.4],
                filename:     `BOQ_${proj.code}_${currentLang.toUpperCase()}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'in', format: 'a4', orientation: 'landscape' }
            };

            html2pdf().set(opt).from(printElement).save().then(() => {
                printElement.classList.add('hidden');
            });
        }

        // Helper Utilities
        function formatMoney(amount) {
            if (amount === undefined || amount === null || isNaN(amount)) return '0';
            return Number(amount).toLocaleString('en-US', { maximumFractionDigits: 2 });
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
