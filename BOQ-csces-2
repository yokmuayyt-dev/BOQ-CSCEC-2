        // Local Dictionary Translation Fallback
        function translateTextLocal(text) {
            if (!text) return '';
            let translated = text;

            for (const [thKey, enVal] of Object.entries(engineeringDictionary)) {
                if (translated.includes(thKey)) {
                    translated = translated.replace(new RegExp(thKey, 'g'), enVal);
                }
            }
            return translated;
        }

        // Gemini AI Translation Engine with Exponential Backoff
        async function translateWithGemini(textsToTranslate) {
            const apiKey = "";
            const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;

            const prompt = `You are a professional civil engineering translator. 
Translate the following Thai construction BOQ texts into professional, standard English construction terms (e.g. RB9 -> Round Bar 9mm, DB25 -> Deformed Bar 25mm SD40, ฐานราก -> Foundation, เสาเข็ม -> Piles, คอนกรีต -> Concrete, etc.).

Input JSON array: ${JSON.stringify(textsToTranslate)}

Respond ONLY with a JSON array of translated strings in the exact same order.
Example: ["Translated 1", "Translated 2"]`;

            const payload = {
                contents: [{ parts: [{ text: prompt }] }],
                generationConfig: {
                    responseMimeType: "application/json"
                }
            };

            let delay = 1000;
            for (let attempt = 0; attempt < 5; attempt++) {
                try {
                    const res = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    if (res.ok) {
                        const result = await res.json();
                        const text = result.candidates?.[0]?.content?.parts?.[0]?.text;
                        if (text) {
                            const parsed = JSON.parse(text);
                            if (Array.isArray(parsed) && parsed.length === textsToTranslate.length) {
                                return parsed;
                            }
                        }
                    }
                } catch (e) {
                    // Retry silently
                }
                await new Promise(r => setTimeout(r, delay));
                delay *= 2;
            }
            return null; // Fallback to local dict if failed
        }

        async function autoTranslateProject() {
            const btn = document.getElementById('btnAutoTranslate');
            const originalHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>กำลังแปลภาษาด้วย AI...</span>`;
            }

            try {
                const proj = getActiveProject();
                const itemsList = [];

                itemsList.push({ type: 'proj_name', obj: proj, text: proj.name });
                itemsList.push({ type: 'proj_desc', obj: proj, text: proj.desc });

                proj.mainCategories.forEach(mc => {
                    itemsList.push({ type: 'mc_title', obj: mc, text: mc.title });
                    mc.subCategories.forEach(sc => {
                        itemsList.push({ type: 'sc_title', obj: sc, text: sc.title });
                        sc.items.forEach(item => {
                            itemsList.push({ type: 'item_desc', obj: item, text: item.desc });
                            itemsList.push({ type: 'item_unit', obj: item, text: item.unit });
                            if (item.note) itemsList.push({ type: 'item_note', obj: item, text: item.note });
                        });
                    });
                });

                const rawTexts = itemsList.map(i => i.text || '');

                // Try Gemini AI Translation
                let translations = await translateWithGemini(rawTexts);

                // Fallback to local engineering dictionary
                if (!translations) {
                    translations = rawTexts.map(t => translateTextLocal(t));
                }

                // Apply translated strings back to project data structure
                itemsList.forEach((item, index) => {
                    const translatedVal = translations[index] || translateTextLocal(item.text);
                    if (item.type === 'proj_name') item.obj.nameEn = translatedVal;
                    if (item.type === 'proj_desc') item.obj.descEn = translatedVal;
                    if (item.type === 'mc_title') item.obj.titleEn = translatedVal;
                    if (item.type === 'sc_title') item.obj.titleEn = translatedVal;
                    if (item.type === 'item_desc') item.obj.descEn = translatedVal;
                    if (item.type === 'item_unit') item.obj.unitEn = translatedVal;
                    if (item.type === 'item_note') item.obj.noteEn = translatedVal;
                });

                saveProjectsToStorage();

                // Switch to English mode so translated text is instantly visible
                setLanguage('en');

                alert('แปลภาษาหมวดงานและรายการด้วย AI เรียบร้อยแล้ว! (สลับโหมดเป็นภาษาอังกฤษให้แล้ว)');
            } catch (err) {
                console.error("Translation error:", err);
                alert('เกิดข้อผิดพลาดในการแปลภาษา กรุณาลองใหม่อีกครั้ง');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            }
        }

